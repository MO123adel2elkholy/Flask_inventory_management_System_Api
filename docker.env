# App runtime environment (loaded into containers)
FLASK_ENV=production
SECRET_KEY=change_me_here
JWT_SECRET_KEY=${SECRET_KEY}

# Database
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change_me_here
POSTGRES_DB=inventory_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Celery app module (set to your celery app module path)
# Example: Ecommerce.celery (must match your project)
CELERY_APP=Ecommerce.celery
CELERY_CONCURRENCY=1

# WSGI app for gunicorn: module:app (default from project)
WSGI_APP=Ecommerce.app:

